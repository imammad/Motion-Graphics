<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.claude.premiere-mcp" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Claude MCP">
  <ExtensionList>
    <Extension Id="com.claude.premiere-mcp.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0" /></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.claude.premiere-mcp.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/premiere.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
          <StartOn><Event>com.adobe.csxs.events.ApplicationActivate</Event></StartOn>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Claude MCP</Menu>
          <Geometry>
            <Size><Height>220</Height><Width>320</Width></Size>
            <MinSize><Height>120</Height><Width>220</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
